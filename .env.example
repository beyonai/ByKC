HOST=0.0.0.0
PORT=8000
SERVICE_NAME=by-qa-manager
# HOST_MACHINE is optional. In production, prefer setting it explicitly.
# When omitted, the service will try to detect a non-loopback local IPv4 and
# fall back to 127.0.0.1 if none is available.

# Redis service registry
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# cluster
# REDIS_CLUSTER_HOST=localhost:6371,localhost:6372,localhost:6373,localhost:6374,localhost:6375,localhost:6376
# REDIS_KEY_SCHEMA_VERSION=v2
# REDIS_USERNAME=
# REDIS_PASSWORD=

AGENT_DATA_PATH=agent_data
LOG_LEVEL=INFO

# Knowledge base storage
DB_HOST=10.10.168.204
DB_PORT=5432
DB_DATABASE=postgres
DB_SCHEMA=byai
DB_USER=gaussdb
DB_PASS=Admin@123
DB_TIMEZONE=Asia/Shanghai
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
KB_MINIO_BUCKET=knowledge-base
KB_MINIO_MARKDOWN_BUCKET=knowledge-base-markdown
MINIO_SECURE=false

# Knowledge base embedding
# Optional: use a custom provider instead of the built-in env provider.
# Format: module:attribute. The attribute can be a provider class, factory, or instance.
BY_QA_MODEL_CONFIG_PROVIDER=
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_BASE_URL=https://embedding.example.com
EMBEDDING_API_KEY=replace-me
EMBEDDING_DIMENSION=1024
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_BATCH_MAX_TEXTS=10

# KnowledgeEntity durable background processing.
# Each enabled API process starts one embedded runner.
KNOWLEDGE_ENTITY_WORKER_ENABLED=true
# Leave blank to generate hostname:pid:random-suffix automatically.
KNOWLEDGE_ENTITY_WORKER_ID=
# Maximum concurrent file tasks per process. Total concurrency is this value
# multiplied by the number of enabled service processes.
KNOWLEDGE_ENTITY_WORKER_CONCURRENCY=4
# Pending-task polling interval.
KNOWLEDGE_ENTITY_WORKER_POLL_SECONDS=3
# Maximum execution time for one file. Timeout is terminal and is not retried.
KNOWLEDGE_ENTITY_TASK_TIMEOUT_SECONDS=1200
# A running task is failed as WORKER_LOST after its lease expires; it is not retried.
KNOWLEDGE_ENTITY_LEASE_SECONDS=180
# Must be shorter than KNOWLEDGE_ENTITY_LEASE_SECONDS.
KNOWLEDGE_ENTITY_HEARTBEAT_SECONDS=30
# Interval for detecting and failing expired running tasks.
KNOWLEDGE_ENTITY_REAPER_SECONDS=30
# Interval for logging worker_id, active tasks, available slots, and loop health.
KNOWLEDGE_ENTITY_WORKER_STATUS_LOG_SECONDS=60
# Maximum wait for active tasks during graceful service shutdown.
KNOWLEDGE_ENTITY_SHUTDOWN_GRACE_SECONDS=60
# Optional module:attribute provider implementing KnowledgeEntityProcessingCallback.
KNOWLEDGE_ENTITY_CALLBACK_PROVIDER=

# Durable per-knowledge-base entity registry and synonym resolution.
ENTITY_EMBEDDING_INDEX_ENABLED=true
ENTITY_SYNONYM_EXACT_ALIAS_ENABLED=true
ENTITY_SYNONYM_ADJUDICATION_ENABLED=true
ENTITY_SYNONYM_TOP_K=3

# Metadata search DSL limits
DSL_MAX_DEPTH=3
DSL_MAX_LEAF_COUNT=12

# Shared LLM / QA models
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_STANDARD_MODEL=gpt-4o
LLM_STANDARD_TEMP=0.7
LLM_STANDARD_EXTRA_BODY=
LLM_LIGHTWEIGHT_MODEL=gpt-4o-mini
LLM_LIGHTWEIGHT_TEMP=0.0
LLM_LIGHTWEIGHT_EXTRA_BODY=
DECOMPOSER_MAX_SUB_QUERIES=5

# Instant QA runtime
LLM_STANDARD_MAX_MODEL_LEN=128000
LLM_LIGHTWEIGHT_MAX_MODEL_LEN=128000
EMBEDDING_MAX_MODEL_LEN=128000
INSTANT_SEARCH_MAX_CONTEXT_RATIO=0.8
INSTANT_SEARCH_RESERVED_TOKENS=2000
INSTANT_SEARCH_MIN_SENTENCE_TOKENS=50

# Knowledge base cache tuning
KB_FETCH_CACHE_TTL_SECONDS=86400
KB_FETCH_CACHE_CLEANUP_INTERVAL_SECONDS=600
KB_UPDATE_TIMELINE_LLM_TIMEOUT_SECONDS=15
